# Keep the build context small. Do NOT exclude src/, util/, test/, dependencies/
# or CMakeLists.txt — the CMake configure references test/ via add_subdirectory,
# and the dependencies/*.cmake fetch SEAL/SealPIR/gRPC at build time.

# Build outputs / caches
build/
cmake-build-*/
bin/
seal_download/
CMakeFiles/

# Benchmark I/O and host-only artifacts
shared_volume/
*.log
target/

# Host-side platform metadata (read by the platform, not needed in the image)
pir-scheme.yaml

# VCS / IDE / dev-container / CI
.git/
.github/
.idea/
.vscode/
.devcontainer/

# Docs & licenses (not needed to build)
*.md
LICENSE*

# Python / OS junk
__pycache__/
*.py[cod]
venv/
.DS_Store

# NOTE: wrapper.py is intentionally NOT ignored — it is copied into the image.
